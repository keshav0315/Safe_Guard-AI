# Django
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development

# Database (PostgreSQL)
DB_NAME=safeguard_db
DB_USER=safeguard_user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# SQLite (development only — set to True to use SQLite instead of PostgreSQL)
USE_SQLITE=False

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# CORS (comma-separated origins for production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Firebase
FIREBASE_CREDENTIALS_PATH=path/to/serviceAccountKey.json
FIREBASE_PROJECT_ID=your-firebase-project-id

# Email (SMTP — for production)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@safeguard.ai
SERVER_EMAIL=server@safeguard.ai

# Sentry (optional — error tracking)
SENTRY_DSN=

# Production only
DJANGO_ADMIN_URL=admin/
DJANGO_ENVIRONMENT=development
